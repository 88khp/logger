{
  "name": "@devraj-labs/logger",
  "version": "1.0.0",
  "description": "Production-grade, platform-independent logging library for JavaScript/TypeScript (React Native + Web)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "example": "ts-node --project tsconfig.json",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "eslint src --ext .ts",
    "release": "npm run build && npm publish --access public"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "react-native",
    "javascript",
    "structured-logging",
    "transport",
    "devraj-labs"
  ],
  "homepage": "https://github.com/devraj-labs/logger",
  "repository": {
    "type": "git",
    "url": "https://github.com/devraj-labs/logger.git"
  },
  "bugs": {
    "url": "https://github.com/devraj-labs/logger/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "author": "devraj-labs",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
